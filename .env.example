# Copy to .env (never commit). In dev prefer: dotnet user-secrets set "Llm:Providers:gemini:ApiKey" "..." --project src/VocalEye.Api
# Only fill the providers you want to appear in the model picker; providers without a key/endpoint are hidden.
Llm__Default__Provider=gemini
Llm__Default__Model=gemini-2.0-flash
Llm__Providers__gemini__ApiKey=
Llm__Providers__openai__ApiKey=
Llm__Providers__anthropic__ApiKey=
Llm__Providers__ollama__Endpoint=http://localhost:11434
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=vocaleye;Username=vocaleye;Password=vocaleye
ConnectionStrings__Redis=localhost:6379
Email__Smtp__Host=smtp.gmail.com
Email__Smtp__Port=587
Email__Smtp__User=
Email__Smtp__AppPassword=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
